# Copy this file to .env and adjust. Never commit the real .env.

# Local SQLite by default. Member 4 replaces this with the cloud Postgres URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./tickets.db
AUTO_CREATE_TABLES=true

# Aurora express configuration uses IAM-only authentication. Lambda loads
# these from the SSM path named by CONFIG_PARAMETER_PREFIX.
DB_IAM_AUTH=false
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_SSL_ROOT_CERT=/var/task/global-bundle.pem
CONFIG_PARAMETER_PREFIX=

# Member 3's AI classification service.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_SECONDS=5.0
# Use "http" locally or "lambda" for direct private AWS invocation.
AI_INVOCATION_MODE=http
AI_LAMBDA_FUNCTION_NAME=

# Change this before deployment. Any long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Comma-separated origins only; do not add paths or a trailing slash.
# Add the final CloudFront origin before deployment.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173
